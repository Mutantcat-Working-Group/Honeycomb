# Build directories
build/
debug/
release/
build_release/
honeycomb_build_release*/
*.build/

# CMake generated files
CMakeCache.txt
CMakeFiles/
Makefile
*.cmake
# Guard tests live in tests/ and CMakeLists.txt registers them, so a blanket
# *.cmake ignore would silently drop a new test from the repo. Negate the
# whole naming convention instead of listing files one by one.
!tests/*Test.cmake
!CMakeLists.txt

